<?xml version="1.0"?>
<robot name="my_robot">

    <link name="base_footprint"/>

    <!-- 본체 링크-->
    <link name="base_link">
          <visual>
                  <geometry>
                            <cylinder radius="0.5" length="1"/>  
                            <!-- <box size="1 1 0.5"/> -->
                  </geometry>
                  <material name="blue">
                            <color rgba="0 0 1 1"/>
                  </material>
                  <origin xyz="0 0 0.3" rpy="0 0 0"/>
          </visual>
  </link>

   <!-- 본체 박스-->
   <link name="base_body">
        <visual>
                <geometry>
                    <cylinder radius="0.3" length="0.3"/>
                </geometry>

                <material name="violet">
                    <color rgba="1 0 1 1"/>
                </material>

                <origin xyz="0 0 0.3" rpy="0 0 0"/>
        </visual>
  </link>

   <!-- 본체 Joint-->
  <joint name="base_body_joint" type="fixed">
      <parent link="base_link"/>
      <child link="base_body"/>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
  </joint>

  <!--라이다-->
  <link name="lidar">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
      <origin xyz="0 0 0.35" rpy="0 0 0"/>
    </visual>
  </link>

  <!-- 라이다 Joint-->  
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar"/>
        <origin xyz="0 0 0.8" rpy="0 0 0"/>
    </joint>

<!-- 왼쪽 바퀴 -->
<link name="left_wheel">
    <visual>
        <geometry>
            <cylinder radius="0.2" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 1.5735 0"/>
    </visual>
</link>

<!-- 왼쪽 바퀴 Joint-->
  <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel"/>
      <origin xyz="-0.525 0 -0.2" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
  </joint>  
  

  <!-- 오른쪽 바퀴-->
  <link name="right_wheel">
      <visual>
          <geometry>
              <cylinder radius="0.2" length="0.05"/>
          </geometry>
          <origin xyz="0 0 0" rpy="0 1.5735 0"/>
      </visual>
  </link> 

  <!-- 오른쪽 바퀴 Joint-->
  <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel"/>
      <origin xyz="0.525 0 -0.2" rpy="0 3.14159 0"/>
      <axis xyz="1 0 0"/>
  </joint>

   <!-- Footprint Joint-->     
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
    </joint>
</robot> 

